# Script mode (cmake -P), run by hearth_embed_file (cmake/HearthEmbed.cmake):
# writes OUT, a C++ file whose function FUNCTION returns the bytes of IN.
file(READ "${IN}" hex HEX)
string(LENGTH "${hex}" n)
if(n EQUAL 0)
  message(FATAL_ERROR "embed_file: ${IN} is empty")
endif()
math(EXPR bytes "${n} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," arr "${hex}")
# 24 bytes per line keeps the generated file readable for diffs and tools.
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){24})" "\\1\n  " arr "${arr}")
file(WRITE "${OUT}.tmp" "// Generated by cmake/embed_file.cmake from ${IN}. Do not edit.
#include <string_view>

namespace hearth::cli {
namespace {
const unsigned char kData[${bytes}] = {
  ${arr}
};
}  // namespace
std::string_view ${FUNCTION}() { return {reinterpret_cast<const char*>(kData), sizeof kData}; }
}  // namespace hearth::cli
")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
