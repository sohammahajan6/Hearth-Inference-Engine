# Compile GLSL compute shaders to SPIR-V at build time and embed them in the
# executable. The shipped binary therefore needs no shader files on disk, and
# a shader edit always rebuilds the binary that uses it.
#
# hearth_add_shaders(<target> <shader.comp>...)
#   For each foo.comp, glslang writes foo.spv.h containing
#   `const uint32_t spv_foo[] = {...};`. A generated registry
#   (shader_registry.cpp) maps the name "foo" to that array.

function(hearth_add_shaders target)
  if(NOT EXISTS "${HEARTH_GLSLANG}")
    message(FATAL_ERROR "glslang not found at ${HEARTH_GLSLANG}. Run: pwsh -File scripts\\setup.ps1 -Only glslang")
  endif()
  set(out_dir "${CMAKE_CURRENT_BINARY_DIR}/spirv")
  file(MAKE_DIRECTORY "${out_dir}")
  set(headers "")
  set(includes "")
  set(entries "")
  foreach(src IN LISTS ARGN)
    get_filename_component(abs "${src}" ABSOLUTE)
    get_filename_component(name "${src}" NAME_WE)
    get_filename_component(dir "${abs}" DIRECTORY)
    file(GLOB includes_glsl "${dir}/*.glsl")
    set(hdr "${out_dir}/${name}.spv.h")
    add_custom_command(
      OUTPUT "${hdr}"
      COMMAND "${HEARTH_GLSLANG}" -V --target-env vulkan1.3 --quiet
              "-I${dir}" --vn spv_${name} -o "${hdr}" "${abs}"
      DEPENDS "${abs}" ${includes_glsl}
      COMMENT "glslang ${name}.comp"
      VERBATIM)
    list(APPEND headers "${hdr}")
    string(APPEND includes "#include \"${name}.spv.h\"\n")
    string(APPEND entries "    {\"${name}\", spv_${name}, sizeof(spv_${name}) / sizeof(uint32_t)},\n")
  endforeach()
  set(registry "${out_dir}/shader_registry.cpp")
  file(CONFIGURE OUTPUT "${registry}" CONTENT [=[
// Generated by cmake/HearthShaders.cmake. Do not edit.
#include <cstdint>
#include <cstring>
#include <span>
@includes@
namespace hearth::gpu {
namespace {
struct Entry { const char* name; const uint32_t* words; std::size_t count; };
constexpr Entry kShaders[] = {
@entries@};
}  // namespace
std::span<const uint32_t> find_shader(const char* name) {
  for (const Entry& e : kShaders) {
    if (std::strcmp(e.name, name) == 0) return {e.words, e.count};
  }
  return {};
}
}  // namespace hearth::gpu
]=] @ONLY)
  target_sources(${target} PRIVATE ${headers} "${registry}")
  target_include_directories(${target} PRIVATE "${out_dir}")
endfunction()
