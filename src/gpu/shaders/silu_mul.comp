#version 460
// SiLU-gated product of the GPU forward pass (08 doc section 3):
// g = g / (1 + exp(-g)) * u, element-wise. exp and the division are not
// correctly rounded in Vulkan; the result is within the ACCEPTANCE
// element-wise bar of cpu::ref::silu (gpu_ops_test).

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) buffer G { float g[]; };
layout(std430, set = 0, binding = 1) readonly buffer U { float u[]; };

layout(push_constant) uniform Push {
  uint n;
} p;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i >= p.n) return;
  const float v = g[i];
  g[i] = v / (1.0 + exp(-v)) * u[i];
}
