#version 450
// Read bandwidth probe: XOR-reduce a buffer with 16-byte loads.
//
// Two access patterns:
//  - grid-stride (blocked == 0): neighbouring invocations read neighbouring
//    16-byte chunks and the whole grid sweeps the buffer as one wave front.
//  - blocked (blocked != 0): workgroup w reads its own contiguous range, as a
//    matrix-vector kernel does when each workgroup owns a few rows. The wave
//    front is then many small regions, which changes DRAM page locality.
// With write_all == 0 the result is stored only if it equals `magic`
// (practically never), which keeps the compiler from deleting the loads
// without adding write traffic. With write_all != 0 every invocation stores
// its partial XOR, so a test can check the reduction against the CPU.

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) readonly buffer Src { uvec4 src[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Dst { uvec4 dst[]; };

layout(push_constant) uniform Push {
  uint n;          // number of uvec4 elements to read
  uint magic;      // see above
  uint write_all;  // nonzero: store every partial result
  uint base;       // first uvec4 element to read (lets the probe rotate through cold memory)
  uint blocked;    // nonzero: per-workgroup contiguous ranges instead of grid-stride
} p;

void main() {
  uvec4 acc = uvec4(0u);
  if (p.blocked == 0u) {
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < p.n; i += stride) {
      acc ^= src[p.base + i];
    }
  } else {
    const uint chunk = (p.n + gl_NumWorkGroups.x - 1u) / gl_NumWorkGroups.x;
    const uint begin = gl_WorkGroupID.x * chunk;
    const uint end = min(begin + chunk, p.n);
    for (uint i = begin + gl_LocalInvocationID.x; i < end; i += gl_WorkGroupSize.x) {
      acc ^= src[p.base + i];
    }
  }
  if (p.write_all != 0u || acc.x == p.magic) {
    dst[gl_GlobalInvocationID.x] = acc;
  }
}
