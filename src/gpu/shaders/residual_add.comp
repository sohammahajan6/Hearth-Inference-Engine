#version 460
// The residual add of the GPU forward pass: x = x + y, element-wise, one
// correctly rounded FP32 add each (the CPU reference's bits).

#extension GL_EXT_spirv_intrinsics : require
spirv_execution_mode(capabilities = [4466], 4461, 32);  // SignedZeroInfNanPreserve, 32-bit

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) buffer X { float x[]; };
layout(std430, set = 0, binding = 1) readonly buffer Y { float y[]; };

layout(push_constant) uniform Push {
  uint n;
} p;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i >= p.n) return;
  precise float s = x[i] + y[i];
  x[i] = s;
}
