#version 450
// FP16 compute peak: same structure as probe_fma32, in half precision.
// Per loop iteration and invocation: 8 x 4 FMAs = 64 FLOPs.

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) writeonly buffer Dst { vec4 dst[]; };

layout(push_constant) uniform Push {
  uint iters;
  float mul;
  float add;
  float magic;
} p;

void main() {
  const f16vec4 x = f16vec4(float(gl_GlobalInvocationID.x & 1023u) * 1e-4) + f16vec4(1.0, 1.25, 1.5, 1.75);
  f16vec4 a0 = x, a1 = x + float16_t(0.1), a2 = x + float16_t(0.2), a3 = x + float16_t(0.3);
  f16vec4 a4 = x + float16_t(0.4), a5 = x + float16_t(0.5), a6 = x + float16_t(0.6), a7 = x + float16_t(0.7);
  const f16vec4 m = f16vec4(p.mul);
  const f16vec4 c = f16vec4(p.add);
  for (uint i = 0u; i < p.iters; ++i) {
    a0 = fma(a0, m, c);
    a1 = fma(a1, m, c);
    a2 = fma(a2, m, c);
    a3 = fma(a3, m, c);
    a4 = fma(a4, m, c);
    a5 = fma(a5, m, c);
    a6 = fma(a6, m, c);
    a7 = fma(a7, m, c);
  }
  const vec4 s = vec4(((a0 + a1) + (a2 + a3)) + ((a4 + a5) + (a6 + a7)));
  if (s.x == p.magic) {
    dst[gl_GlobalInvocationID.x] = s;
  }
}
